{% extends 'base.html.twig' %}

{% block title %}Vrai ou Faux ?{% endblock %}

{% block body %}
    {% if question %}
        <h1>Vrai ou Faux&nbsp;?</h1>
        <p class="sous-titre">{{ question.categorie.nom }}</p>

        <div class="enonce">{{ question.libelle }}</div>

        <form action="{{ path('jeu_reponse') }}" method="post" class="boutons">
            <input type="hidden" name="questionId" value="{{ question.id }}">
            <button type="submit" name="reponse" value="1" class="btn-vrai">Vrai</button>
            <button type="submit" name="reponse" value="0" class="btn-faux">Faux</button>
        </form>

        <a class="retour" href="{{ path('poquizqui_index') }}">← Les catégories</a>
    {% else %}
        <p class="vide">Aucune question disponible pour le moment.</p>
    {% endif %}
{% endblock %}