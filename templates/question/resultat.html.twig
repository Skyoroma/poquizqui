{% extends 'base.html.twig' %}

{% block title %}Résultat{% endblock %}

{% block body %}
    <div class="verdict">
        {% if estCorrect %}
            <span class="emoji">✅</span>
            <h1 class="gagne">Bien joué&nbsp;!</h1>
        {% else %}
            <span class="emoji">❌</span>
            <h1 class="perdu">Raté&nbsp;!</h1>
        {% endif %}
    </div>

    <div class="enonce">
        {{ question.libelle }}
        <p class="sous-titre" style="margin-top:1rem">
            La bonne réponse était
            <span class="badge {{ question.estVraie ? 'badge-vrai' : 'badge-faux' }}">
                {{ question.estVraie ? 'Vrai' : 'Faux' }}
            </span>
        </p>
    </div>

    <div class="boutons">
        <button type="button" onclick="location.href='{{ path('jeu') }}'">Question suivante →</button>
    </div>

    <a class="retour" href="{{ path('categorie_index') }}">← Les catégories</a>
{% endblock %}