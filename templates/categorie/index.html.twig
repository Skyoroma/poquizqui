{% extends 'base.html.twig' %}

{% block title %}Les catégories{% endblock %}

{% block body %}
    <h1>Les catégories</h1>
    <p class="sous-titre">Choisis un thème ou lance une partie au hasard.</p>

    <ul class="liste">
        {% for categorie in categories %}
            <li class="carte carte-lien">
                <a href="{{ path('poquizqui_show', {id: categorie.id}) }}">{{ categorie.nom }}</a>
                <span class="badge">{{ categorie.questions|length }} questions</span>
            </li>
        {% else %}
            <li class="vide">Aucune catégorie pour le moment.</li>
        {% endfor %}
    </ul>

    <a class="retour" href="{{ path('jeu') }}">→ Jouer</a>
{% endblock %}